{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "var/infection.log",
        "html": "var/infection.html",
        "summary": "var/infection-summary.log",
        "json": "var/infection.json",
        "perMutator": "var/infection-per-mutator.md",
        "stryker": {
            "report": "main"
        }
    },
    // Phase 5 mutation policy is HYBRID: kill behaviourally-meaningful
    // mutants with real tests; ignore mutants that are equivalent (no input
    // can distinguish them) or that only alter diagnostic exception-message
    // text. Every ignore below names a concrete, reviewed reason — we do not
    // ignore by file wholesale.
    "mutators": {
        "@default": true,
        // Visibility mutators rewrite a method/property *signature* line,
        // which line coverage never records as an executable statement — so
        // Infection reports every one as "not covered" and never runs it. They
        // are uncoverable by construction, not a test gap. Visibility contracts
        // are enforced by PHPStan level 9 (and any real over-restriction breaks
        // callers at compile time), so these add no behavioural signal.
        "PublicVisibility": false,
        "ProtectedVisibility": false,
        // Exception-message *construction*. The `(signature $i)` labels and
        // the describe() helpers feed only error-message text; killing them
        // means asserting interpolated message strings, which is brittle.
        "Concat": {
            "ignore": [
                "Medzuch\\Jwt\\Jws\\JsonSerializer::deserialize",
                "Medzuch\\Jwt\\Jws\\JsonSerializer::describe"
            ]
        },
        "ConcatOperandRemoval": {
            "ignore": [
                "Medzuch\\Jwt\\Jws\\JsonSerializer::deserialize",
                "Medzuch\\Jwt\\Jws\\JsonSerializer::describe"
            ]
        },
        "MatchArmRemoval": {
            "ignore": [
                // describe() match arms select diagnostic words; the b64
                // disagreement message is substring-asserted in tests, the
                // exact arm wording is not.
                "Medzuch\\Jwt\\Jws\\JsonSerializer::describe",
                "Medzuch\\Jwt\\Jws\\Signer::describe"
            ]
        },
        // Equivalent mutants — no input distinguishes original from mutant.
        "LessThanOrEqualTo": {
            // count($protectedHeaders) <= 1: with exactly one signature the
            // loop compares the sole header to itself, so `< 1` yields the
            // identical "no disagreement" outcome.
            "ignore": ["Medzuch\\Jwt\\Jws\\JsonSerializer::assertB64AgreementAcrossSignatures"]
        },
        // (The `$protectedHeaders[0]` IncrementInteger equivalent is handled by
        // a tight inline @infection-ignore-all on that one line, so the killable
        // `count <= 1` boundary mutant stays in the gate. Exception code-0
        // mutants are eliminated at source via the named `previous:` argument.)
        // strpos()/strrpos() return `false` together (no delimiter) or both
        // an int (delimiter present), so `$first === false`, `$last === false`
        // and the `||` between them cannot be distinguished by any input.
        "FalseValue": {
            "ignore": ["Medzuch\\Jwt\\Jws\\CompactSerializer::splitSegments"]
        },
        "LogicalOr": {
            "ignore": ["Medzuch\\Jwt\\Jws\\CompactSerializer::splitSegments"]
        }
    },
    "testFramework": "phpunit",
    // Keep mutant scratch space on the container's native filesystem rather
    // than a bind-mounted project dir: parallel create/delete of the temp
    // mutants is slow and races on a Windows-mounted volume (WSL2/Docker),
    // which surfaced as a post-run FilesystemIterator cleanup crash. Logs
    // (see "logs" above) still land in the project's var/ for inspection.
    "tmpDir": "/tmp/infection",
    // Gate design — the real bar is Covered-code MSI, not overall MSI:
    //
    //  - minCoveredMsi (95) is the quality gate that matters: of the code the
    //    suite actually executes, how much do the tests assert hard enough to
    //    kill a mutation? This cannot be satisfied by ignoring, because there is
    //    nothing to ignore — untested code is simply out of its scope. Genuinely
    //    equivalent mutants on *covered* code (hygiene, diagnostic message
    //    helpers, opaque cache keys) are the only @infection-ignore-all cases.
    //
    //  - minMsi (85) is a deliberately loose *backstop* on testing breadth, not
    //    the primary gate. Overall MSI counts uncovered code, so it drops if
    //    whole areas stop being exercised — but it sits far below the actual
    //    score (~96%) so it never pressures us to @infection-ignore legitimate
    //    defensive / unreachable guards; those use @codeCoverageIgnore instead,
    //    which removes them from both coverage and Covered MSI honestly.
    "minMsi": 85,
    "minCoveredMsi": 95
}
